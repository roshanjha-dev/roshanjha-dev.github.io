<!-- Cipher Typing + Moving Cursor Loop Section -->
<section class="typing-hero">
  <h2 id="typing-text"></h2>
</section>

<style>
  .typing-hero {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start; 
    margin-top: 10px;
    font-family: 'Verdana', Geneva, sans-serif; 
    font-style: italic; 
    color: #2a9d8f; 
    min-height: 2em;
  }

  #typing-text {
    font-size: 1rem;
    font-weight: 500;
    white-space: pre;
    position: relative;
  }

  .cursor {
    display: inline-block;
    width: 3px;
    height: 1.3em;
    background-color: #2a9d8f;
    margin-left: 2px;
    animation: blink 0.7s steps(1) infinite;
    vertical-align: bottom;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }
</style>



<script>
  const targetText = "Passionate in Network Security and Privacy";
  const typingText = document.getElementById('typing-text');
  const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*()";

  let display = Array(targetText.length).fill("");
  let phase = "typeCipher"; // typeCipher -> erase -> resolve
  let charIndex = 0;
  const typingSpeed = 50;
  const eraseSpeed = 30;
  const resolveSpeed = 30;
  const pauseBetween = 800;

  function randomChar() {
    return chars.charAt(Math.floor(Math.random() * chars.length));
  }

  function updateDisplay() {
    // ✅ Cursor appended at end every frame, but only once
    typingText.innerHTML = display.join('') + '<span class="cursor"></span>';
  }

  function animate() {
    switch (phase) {
      case "typeCipher":
        for (let i = 0; i <= charIndex; i++) {
          display[i] = targetText[i] === " " ? " " : randomChar();
        }
        updateDisplay();
        charIndex++;
        if (charIndex >= targetText.length) {
          phase = "erase";
          charIndex = targetText.length - 1;
          setTimeout(animate, pauseBetween);
        } else {
          setTimeout(animate, typingSpeed);
        }
        break;

      case "erase":
        display[charIndex] = "";
        updateDisplay();
        charIndex--;
        if (charIndex < 0) {
          phase = "resolve";
          charIndex = 0;
          setTimeout(animate, pauseBetween);
        } else {
          setTimeout(animate, eraseSpeed);
        }
        break;

      case "resolve":
        for (let i = 0; i <= charIndex; i++) {
          display[i] = targetText[i];
        }
        updateDisplay();
        charIndex++;
        if (charIndex >= targetText.length) {
          phase = "typeCipher";
          charIndex = 0;
          setTimeout(animate, pauseBetween);
        } else {
          setTimeout(animate, resolveSpeed);
        }
        break;
    }
  }

  document.addEventListener('DOMContentLoaded', animate);
</script>